# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/remon_download

# Security & CORS Configuration
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret-value

# Reverse Proxy Configuration (true, false, or comma-separated IP/CIDR values)
TRUST_PROXY=false

# Runtime Tools Configuration
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Download Configuration
DOWNLOAD_DIRECTORY=
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_TIMEOUT_MS=3600000

# Metadata Analysis Configuration
METADATA_TIMEOUT_MS=30000
METADATA_MAX_CONCURRENT=2

# Node Environment
NODE_ENV=development

